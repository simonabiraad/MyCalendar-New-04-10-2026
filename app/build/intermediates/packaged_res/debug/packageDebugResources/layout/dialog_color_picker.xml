<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select &amp; Fine-Tune Color"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:paddingBottom="12dp" />

        <!-- Preview and Hex Code Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/colorPreview"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:background="#4CAF50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hex:"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/hexInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#2A2A2A"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center_vertical"
                android:inputType="textCapCharacters"
                android:maxLength="9" />
        </LinearLayout>

        <!-- HSV Controls -->
        <TextView
            android:id="@+id/hueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hue: 0°"
            android:textColor="#DDDDDD"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/hueSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="360"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/satText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saturation: 100%"
            android:textColor="#DDDDDD"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/satSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/valText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brightness: 100%"
            android:textColor="#DDDDDD"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/valSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <!-- RGB Fine Tuning Controls -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/redText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Red: 76"
            android:textColor="#FF6666"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/redSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:paddingTop="4dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/greenText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Green: 175"
            android:textColor="#66FF66"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/greenSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:paddingTop="4dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/blueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blue: 80"
            android:textColor="#6666FF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/blueSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <!-- Quick Presets Palette -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Swatches"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:paddingTop="4dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/presetsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnCancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#AAAAAA" />

            <Button
                android:id="@+id/btnSave"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="#2196F3"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
