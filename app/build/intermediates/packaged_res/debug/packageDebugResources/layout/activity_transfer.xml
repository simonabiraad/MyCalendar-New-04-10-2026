<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transfer_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".TransferActivity">

    <LinearLayout
        android:id="@+id/transferTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/transferBackButton"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_color" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/transfer"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transferTopBar">

        <TextView
            android:id="@+id/lblDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date &amp; Time"
            android:textColor="@color/light_green"
            android:textSize="@dimen/_11ssp"
            android:layout_marginBottom="@dimen/_6sdp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/_18sdp">

            <LinearLayout
                android:id="@+id/transferDatePickerBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_weight="1"
                android:background="@drawable/summary_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_9sdp"
                android:paddingEnd="@dimen/_9sdp">

                <TextView
                    android:id="@+id/txtTransferDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="02-08-2026"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp" />

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_menu_calendar_color" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transferTimePickerBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:layout_weight="1"
                android:background="@drawable/summary_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_9sdp"
                android:paddingEnd="@dimen/_9sdp">

                <TextView
                    android:id="@+id/txtTransferTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15:00"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp" />

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_notif_clock_color" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/lblFromAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="From Account"
            android:textColor="@color/light_green"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerFromAccount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/summary_border"
            android:padding="8dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/lblToAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="To Account"
            android:textColor="@color/light_green"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerToAccount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/summary_border"
            android:padding="8dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/lblAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount"
            android:textColor="@color/light_green"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTransferAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/summary_border"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnPerformTransfer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/light_green"
            android:text="Transfer Now"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
