<resources>
    <!-- Base application theme. -->
    <style name="Theme.MyCalendar2026SAR" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/light_green</item>
        <item name="colorPrimaryVariant">@color/hunter_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/light_green</item>
        <item name="colorSecondaryVariant">@color/light_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>

        <item name="android:listPreferredItemPaddingStart">8dp</item>
        <item name="android:listPreferredItemPaddingEnd">8dp</item>
        <item name="android:textAppearanceLargePopupMenu">@style/CustomMenuTextAppearance</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/CustomMenuTextAppearance</item>
        <item name="android:popupMenuStyle">@style/CustomPopupMenuStyle</item>

        <!-- Dialog button colors -->
        <item name="materialAlertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/light_green</item>
        <item name="colorAccent">@color/light_green</item>
        <item name="colorSecondary">@color/light_green</item>
        <item name="android:textColorPrimary">@color/white</item>
        <!-- For standard AlertDialog buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/GreenButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/GreenButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/GreenButtonStyle</item>
    </style>

    <style name="GreenButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/light_green</item>
    </style>

    <style name="CustomDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/light_green</item>
        <item name="colorOnPrimary">@color/black</item>
    </style>
</resources>