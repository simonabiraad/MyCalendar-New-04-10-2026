<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogPaymentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvGooglePlayHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Google Play"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivShieldIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_google_play_shield"
            android:contentDescription="Google Play Security Shield"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPaymentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add payment method to your Google Account"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user@gmail.com"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPaymentDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a payment method to your Google Account to complete your purchase. Your payment information is only visible to Google."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="start"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnAddCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add credit or debit card"
        android:textColor="@color/white"
        android:drawableStart="@drawable/ic_menu_accounts_color"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical|start"
        android:backgroundTint="@color/light_green" />

</LinearLayout>
