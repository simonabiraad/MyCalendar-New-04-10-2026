<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackEdit"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/editTitleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/editTitleIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Event Icon"
                android:src="@drawable/ic_menu_calendar_color" />

            <TextView
                android:id="@+id/editTitleHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Event"
                android:textColor="@color/light_green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/editBottomActions"
        app:layout_constraintTop_toBottomOf="@id/editTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:textColor="@color/light_green"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTitle"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/summary_border"
                    android:hint="Event Title"
                    android:padding="8dp"
                    android:textColor="@color/white"
                    android:textColorHint="#888888" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Date Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/dateBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/editDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Select Date"
                                android:textColor="@color/white" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_menu_calendar_color" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="match_parent" />

                    <!-- All Day Section -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Day"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/allDayStatusBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvAllDayStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="OFF"
                                android:textColor="@color/white"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAllDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@color/light_green"
                                app:trackTint="@color/gray" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Start Time Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start Time"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/startTimeBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/editStartTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="00:00"
                                android:textColor="@color/white" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_notif_clock_color" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="match_parent" />

                    <!-- End Time Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End Time"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/endTimeBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/editEndTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="00:00"
                                android:textColor="@color/white" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_notif_clock_color" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Reminder | Repeater -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reminder"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/reminderBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvReminderValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="At event time"
                                android:textColor="@color/white" />

                            <ImageView
                                android:id="@+id/btnReminderArrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/white" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Repeater"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/repeatBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvRepeatValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="None"
                                android:textColor="@color/white" />

                            <ImageView
                                android:id="@+id/btnRepeatArrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3: Category | Priority -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/categoryBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvCategoryValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Other"
                                android:textColor="@color/white" />

                            <ImageView
                                android:id="@+id/btnCategoryArrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/white" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Priority"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/priorityBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvPriorityValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Medium"
                                android:textColor="@color/white" />

                            <ImageView
                                android:id="@+id/btnPriorityArrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4: Status | Event Color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/statusBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/viewStatusDot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_indicator"
                                android:backgroundTint="#FBBC05" />

                            <TextView
                                android:id="@+id/tvStatusValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pending"
                                android:textColor="@color/white" />

                            <ImageView
                                android:id="@+id/btnStatusArrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/white" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Event Color"
                            android:textColor="@color/light_green"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/colorBox"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/summary_border"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <View
                                android:id="@+id/viewEventColorDot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_indicator"
                                android:backgroundTint="#34A853" />

                            <TextView
                                android:id="@+id/tvEventColorValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Default"
                                android:textColor="@color/white" />

                            <ImageView
                                android:id="@+id/btnEventColorArrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Location"
                    android:textColor="@color/light_green"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editLocation"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/summary_border"
                    android:hint="Enter location"
                    android:padding="8dp"
                    android:textColor="@color/white"
                    android:textColorHint="#888888" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAddAttachment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/light_green"
                        android:text="Add Attachment"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/btnRecordVoice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/light_green"
                        android:text="Record Voice Note"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="16dp"
                android:text="Notes"
                android:textColor="@color/light_green"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/summary_border"
                android:gravity="top"
                android:hint="Event description..."
                android:minLines="5"
                android:padding="8dp"
                android:textColor="@color/white"
                android:textColorHint="#888888" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/editBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnCancelEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="CANCEL"
            android:textColor="@color/red"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="SAVE"
            android:textColor="@color/light_green"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
