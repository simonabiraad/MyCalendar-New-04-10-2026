<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/calcDisplay"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:background="#333333"
        android:gravity="end|center_vertical"
        android:padding="12dp"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <!-- Row 1 -->
        <Button
            android:id="@+id/btnCalcClear"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="C"
            android:textColor="@color/expense_red"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalcBack"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="⌫"
            android:textColor="@color/light_green"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalcDiv"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="÷"
            android:textColor="@color/light_green"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnCalcMult"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="×"
            android:textColor="@color/light_green"
            android:textSize="20sp" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/btnCalc7"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="7"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalc8"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="8"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalc9"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="9"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalcSub"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="-"
            android:textColor="@color/light_green"
            android:textSize="20sp" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/btnCalc4"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="4"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalc5"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="5"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalc6"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="6"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalcAdd"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="+"
            android:textColor="@color/light_green"
            android:textSize="20sp" />

        <!-- Row 4 -->
        <Button
            android:id="@+id/btnCalc1"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalc2"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalc3"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalcEqual"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="120dp"
            android:layout_rowSpan="2"
            android:backgroundTint="@color/light_green"
            android:text="="
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Row 5 -->
        <Button
            android:id="@+id/btnCalc0"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_columnSpan="2"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCalcDot"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="."
            android:textColor="@color/white"
            android:textSize="18sp" />

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCalcCancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnCalcOk"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            android:textColor="@color/light_green"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
