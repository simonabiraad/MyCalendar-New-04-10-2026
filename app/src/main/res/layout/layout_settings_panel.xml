<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsPanelContainer"
    android:layout_width="@dimen/_150sdp"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="6dp"
    android:visibility="gone">

    <!-- Change Password -->
    <LinearLayout
        android:id="@+id/menuChangePassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/action_change_password"
            android:src="@drawable/ic_menu_password_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/action_change_password"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
    </LinearLayout>

    <!-- Notification Settings -->
    <LinearLayout
        android:id="@+id/menuNotificationSettings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/action_notification_settings"
            android:src="@drawable/ic_menu_settings_color"
            android:padding="2dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/action_notification_settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
    </LinearLayout>

    <!-- Toggle Quick Note Bar -->
    <LinearLayout
        android:id="@+id/menuToggleQuickBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/action_toggle_quick_bar"
            android:src="@drawable/ic_menu_quick_bar_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/action_toggle_quick_bar"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
    </LinearLayout>

    <!-- Date Ascending -->
    <LinearLayout
        android:id="@+id/menuSortDateAsc"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/menu_date_ascending"
            android:src="@drawable/ic_menu_sort_asc_color" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/menu_date_ascending"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
        <TextView
            android:id="@+id/tvSortDateAscState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Date Descending -->
    <LinearLayout
        android:id="@+id/menuSortDateDesc"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/menu_date_descending"
            android:src="@drawable/ic_menu_sort_desc_color" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/menu_date_descending"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
        <TextView
            android:id="@+id/tvSortDateDescState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dark Mode -->
    <LinearLayout
        android:id="@+id/menuDarkMode"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="Dark Mode"
            android:src="@drawable/ic_menu_dark_mode" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Dark Mode"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDarkModeMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Change Colors -->
    <LinearLayout
        android:id="@+id/menuChangeColors"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/action_change_colors"
            android:src="@drawable/ic_menu_color_palette" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/action_change_colors"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
    </LinearLayout>

    <!-- Change Font -->
    <LinearLayout
        android:id="@+id/menuChangeFont"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/action_change_font"
            android:src="@drawable/ic_menu_font_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/action_change_font"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
    </LinearLayout>

    <!-- Backup Data -->
    <LinearLayout
        android:id="@+id/menuBackupData"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/action_backup_data"
            android:src="@drawable/ic_menu_backup_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/action_backup_data"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
    </LinearLayout>

    <!-- Print -->
    <LinearLayout
        android:id="@+id/menuPrint"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@string/action_print"
            android:src="@drawable/ic_menu_print_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/action_print"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />
    </LinearLayout>

</LinearLayout>