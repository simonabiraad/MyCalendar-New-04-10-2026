<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyCalendar2026SAR"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:clearTaskOnLaunch="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SecureBoxActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".CategoryActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ExpensesActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".IncomeActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ExpenseTypeActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".TransferActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".AccountSummaryActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".TransactionNamesActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".SummaryActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ReportAllActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".DeletedTransactionsActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ExpensesSettingsActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".NotebookActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ImageEditorActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".TaskActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ExpensesCalendarActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ChartActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".RatesActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".RecommendActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".AccountsOverviewActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".TransactionsAllAccountsActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".CashCalculatorActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".AddRemoveCurrencyActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />

        <activity
            android:name=".DayDetailsActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />

        <activity
            android:name=".NotificationDetailsActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EventsActivity"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@style/Theme.MyCalendar2026SAR" />

        <service
            android:name=".QuickNoteNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent UI for quick note taking" />
        </service>

        <receiver android:name=".ReminderReceiver" android:exported="false" />

        <!-- Professional 4x4 SAR Dashboard Widget -->
        <receiver android:name=".SARCalendarWidget4x4" android:exported="false" android:label="SAR Dashboard (4x4)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sar_widget_4x4_info" />
        </receiver>

        <service android:name=".WidgetListService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>